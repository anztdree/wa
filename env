# ====================================================
# WhatsApp Bot — Environment Variables
# ====================================================
# API Key untuk masing-masing AI provider.
# Isi sesuai provider yang aktif dipakai di dashboard.
# Cukup isi provider yang dipakai — sisanya biarkan kosong.
# ====================================================

# NVIDIA NIM — https://build.nvidia.com/
NVIDIA_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# SambaNova — https://cloud.sambanova.ai/
SAMBANOVA_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral AI — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Cohere — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# SiliconFlow — https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# Z AI (Zhipu) — https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# Cloudflare Workers AI — https://dash.cloudflare.com/profile/api-tokens
# Perlu dua nilai: API Token + Account ID
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ====================================================
# Port untuk Web UI (default: 3500)
# ====================================================
PORT=3500
